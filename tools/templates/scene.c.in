/* ---- scene-private state: presentation only, reset in on_enter ---- */

/* ---- callbacks ---- */

static void on_enter(Engine *e, Scene *s) {
  (void)e; (void)s;
  /* load assets, build menus, reset statics */
}

static void on_exit(Engine *e, Scene *s) {
  (void)e; (void)s;
  /* free sounds, stop music */
}

static void handle_input(Engine *e, Scene *s, const Input *in) {
  (void)s;
  if (key_pressed(in, KEY_ESCAPE)) engine_pop(e);
}

static void update(Engine *e, Scene *s, float dt) {
  (void)s; (void)dt;
  GameState *g = e->user;   /* the world lives here */
  (void)g;
}

static void render(Engine *e, Scene *s, float alpha) {
  (void)e; (void)s; (void)alpha;
  draw_debug_text(20, 20, COLOR_WHITE, "@UPPER@");
}

/* ---- the one public function ---- */

Scene *@NAME@_scene(void) {
  static Scene sc = {
    .name = "@NAME@",
    .on_enter = on_enter,
    .on_exit = on_exit,
    .handle_input = handle_input,
    .update = update,
    .render = render,
    .blocks_update_below = @BLOCK_UPDATE@,
    .blocks_render_below = @BLOCK_RENDER@,
  };
  return &sc;
}
