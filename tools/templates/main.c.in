#include "engine.h"
#include "engine_main.h"   /* provides WinMain on Windows; include only here */
#include "scenes.h"
#include "game_state.h"
#include "gge_config.h"    /* GGE_* from gge.conf; regenerate with: gge config */

static GameState state;

int main(void) {
  static Engine e;
  EngineConfig cfg = {
    .title        = GGE_TITLE,
    .logical_w    = GGE_LOGICAL_W,
    .logical_h    = GGE_LOGICAL_H,
    .window_scale = GGE_WINDOW_SCALE,
    .tick_rate    = GGE_TICK_RATE,
    .user         = &state,
    .org          = GGE_ORG,
    .app          = GGE_APP,
    .audio        = false,
    .text         = false,
    .gamepad      = false,
  };
  if (!engine_init(&e, &cfg)) return 1;
  engine_push(&e, title_scene());
  engine_run(&e);
  engine_shutdown(&e);
  return 0;
}
