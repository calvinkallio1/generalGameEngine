// src/game_state.h  (generated by gge init)
#pragma once
#include <stdint.h>
#include <stdbool.h>
#include <time.h>
#include "mathx.h"
#include "rng.h"

#define SAVE_VERSION 1
#define FIXED_SEED   0        /* non-zero: same world every new game (debugging) */

/* Everything a save must remember. Pointer-free so it saves by memcpy. */
typedef struct GameState {
  uint64_t rng;
  uint32_t ticks;
  Vec2 player_pos;
} GameState;

static inline void game_state_init(GameState *g) {
  *g = (GameState){0};
  g->rng = FIXED_SEED ? FIXED_SEED : (uint64_t)time(NULL) * 0x9E3779B97F4A7C15ULL;
  g->player_pos = (Vec2){ 100, 100 };
}
